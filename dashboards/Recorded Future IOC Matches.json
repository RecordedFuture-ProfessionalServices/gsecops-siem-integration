            "dashboardQueries": [
                {
                    "name": "cfe523bf-ddc4-4afd-962e-0c42d5706864",
                    "query": "ioc.feed_name = \"Recorded Future IOC\"\nioc.ioc_type = \"IOC_TYPE_DOMAIN\"\n\nioc.ioc_value = $ioc\nioc.confidence_score = $conf\n$user = strings.coalesce( ioc.asset.hostname, ioc.asset.asset_ip_address )\n\nmatch:\n    $ioc, $conf\n\noutcome:\n    $matches = count($ioc)\n    $assets = count_distinct($user)\n\norder:\n    $conf desc,\n    $matches desc\nlimit:\n    100",
                    "input": {
                        "relativeTime": {
                            "timeUnit": "DAY",
                            "startTimeVal": "5"
                        }
                    },
                    "etag": "bf115d583ac7e3c4a708cf82cb63a18f5d0c6e14729969387dbf240b5f5179a6"
                },
                {
                    "name": "e7370ee0-dda5-4bac-aa54-c3f64f06e26b",
                    "query": "detection.detection.rule_name = /rf_*/ nocase\n\n$Name = detection.detection.rule_name\n$Date = timestamp.get_date(detection.created_time.seconds)\nmatch:\n    $Name, $Date\n\noutcome:\n    $Count = count(detection.id)\n\norder:\n    $Count desc",
                    "input": {
                        "relativeTime": {
